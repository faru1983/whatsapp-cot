# ==============================================================================
# CONFIGURACIÓN PRINCIPAL DEL BOT
# Copia este archivo a .env y completa tus claves reales.
# NUNCA subas el archivo .env al repositorio.
# ==============================================================================

# Proveedor de Inteligencia Artificial activo.
# Opciones admitidas: gemini, nvidia
LLM_PROVIDER=nvidia

# Números de WhatsApp de los administradores (sin +), separados por coma.
# Reciben alertas SOS y cotizaciones confirmadas.
ADMIN_NUMBERS=56912345678

# Etiquetas de WhatsApp Business
# - Asistencia / Cotizacion *: el bot las crea/asegura (ensure=true).
# - Cliente potencial / Nuevo pedido: etiquetas DEFAULT de WA Business.
#   Solo addChatLabel (ensure=false). IDs descubiertos con scripts/try-chat-label.mjs --watch.
LABEL_ASISTENCIA_NAME=Asistencia
LABEL_ASISTENCIA_ID=99
LABEL_ASISTENCIA_MARK_UNREAD=true

# CRM engaged
LABEL_CLIENTE_POTENCIAL_NAME=Cliente potencial
LABEL_CLIENTE_POTENCIAL_ID=4
LABEL_CLIENTE_POTENCIAL_MARK_UNREAD=false

# CRM quoted (cotización evento / venta barril)
LABEL_NUEVO_PEDIDO_NAME=Nuevo pedido
LABEL_NUEVO_PEDIDO_ID=6
LABEL_NUEVO_PEDIDO_MARK_UNREAD=false

LABEL_COTIZACION_BARRILES_NAME=Cotizacion Barriles
LABEL_COTIZACION_BARRILES_ID=98
LABEL_COTIZACION_BARRILES_MARK_UNREAD=false

LABEL_COTIZACION_EVENTOS_NAME=Cotizacion Eventos
LABEL_COTIZACION_EVENTOS_ID=97
LABEL_COTIZACION_EVENTOS_MARK_UNREAD=false

# Alias legacy (opcional): si no defines LABEL_ASISTENCIA_*, se usan estos.
# SOS_LABEL_NAME=Asistencia
# SOS_LABEL_ID=99
# SOS_MARK_UNREAD=true

# ==============================================================================
# RED DE SEGURIDAD (engine.js)
# ==============================================================================

# Anti-loop: respuestas no entendidas seguidas antes de silenciar y avisar al admin.
# Recomendado: 2 para leads de Meta Ads (handoff rápido a humano).
SECURITY_MAX_CONSECUTIVE_ERRORS=2

# Cambio de intención: veces que el cliente puede alternar barriles ↔ eventos al inicio.
SECURITY_MAX_INTENT_SWITCHES=3

# ==============================================================================
# RITMO DE RESPUESTA (burbujas WhatsApp)
# Evita que 2–3 mensajes salgan de golpe. Durante la espera se muestra
# "escribiendo…". Usa 0 para desactivar. Decimales OK (ej. 1.5).
# ==============================================================================
# Segundos antes de la 1ª burbuja (después de procesar lo que escribió el cliente)
REPLY_DELAY_AFTER_USER_SEC=1
# Segundos entre burbujas del mismo turno (texto → imagen → menú, etc.)
REPLY_DELAY_BETWEEN_BUBBLES_SEC=1.5

# ==============================================================================
# REACTIVACIÓN POR INACTIVIDAD (nudge)
# Híbrido: el cliente lleva NUDGE_MIN_INACTIVE_HOURS sin responder Y la hora
# local (NUDGE_TIMEZONE) está en NUDGE_CRON_HOURS. Máximo 1 nudge por sesión
# hasta que el cliente escriba de nuevo. NO mutea el chat.
# ==============================================================================
NUDGE_ENABLED=false
NUDGE_STATES=BARRILES_FILTRO_CANAL,EVENTOS_RECOGIDA_DATOS
NUDGE_MIN_INACTIVE_HOURS=4
NUDGE_CRON_HOURS=11,21
NUDGE_TIMEZONE=America/Santiago
NUDGE_SCAN_SECONDS=300
NUDGE_MAX_PER_STALL=1
NUDGE_INCLUDE_WEB=true
NUDGE_INCLUDE_INSTAGRAM=true
NUDGE_MAX_INBOUND_AGE_HOURS=24

# ==============================================================================
# API COTIZACIONES WEB (cocktailsontap.cl)
# Eventos: POST /api/v1/quotes + GET /api/v1/catalog (productos/precios vivos)
# Barriles: POST /api/v1/direct-sales
# OBLIGATORIO en producción (NODE_ENV=production). Sin esto el bot cierra en
# modo legacy: avisa por WhatsApp pero NO crea la compra/cotización en la web.
# ==============================================================================
# URL del sitio (producción o localhost si pruebas la API en local)
COT_API_BASE_URL=https://cocktailsontap.cl
# Mismo valor que INTEGRATION_API_KEY en el proyecto web (.env.local / Vercel)
COT_API_KEY=
# Simulador (npm run test:local): mock | ask | vacío
# - vacío + CLI → ask (tras OK: 1️⃣ API real / 2️⃣ simulada)
# - mock / 1 → nunca POSTea quotes/ventas/contacts (link de prueba)
# - ask → menú 1/2 en confirmar (también /api mock|real|ask en el CLI)
# En WhatsApp real (npm start) dejar vacío o real; no uses ask en producción.
# COT_API_MOCK=

# ==============================================================================
# CONFIGURACIÓN DE GOOGLE (GEMINI)
# ==============================================================================
# Obtén tu API Key en: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelos de Gemini (ejemplos):
# - gemini-2.5-flash
# - gemini-2.5-flash-8b
# - gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash-8b

# ==============================================================================
# CONFIGURACIÓN DE NVIDIA (NIM)
# ==============================================================================
# Obtén tu API Key en: https://build.nvidia.com/
NVIDIA_API_KEY=

# Modelos de Nvidia (ejemplos):
# - meta/llama-3.1-8b-instruct
# - meta/llama-3.3-70b-instruct
# - mistralai/mistral-7b-instruct-v0.3
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
