{
  "name": "whatsapp-cot",
  "version": "1.0.0",
  "description": "Lightweight WhatsApp bot with Baileys and LLMs, grounded on a simple local config file.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test:local": "node src/core/engine.js",
    "test:flows": "node scripts/verify-flows.mjs",
    "test:cot-api": "node scripts/smoke-cot-api.mjs",
    "test:cot-api-mocked": "node scripts/test-cot-api-mocked.mjs",
    "verify": "npm run check && npm run test:flows && npm run test:cot-api-mocked",
    "check": "node scripts/syntax-check.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "openai": "^6.45.0",
    "pino": "^9.5.0"
  }
}
